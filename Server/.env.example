PORT=5080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Admin CMS (defaults for local only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=prime-admin-dev-secret-change-me

# Database — the only database setting (Supabase › Connect › connection string).
# Tables are created automatically on startup. Unset = local JSON store (dev only).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dizqjrovjqfmrgdgntyf.supabase.co:5432/postgres

# Cloudinary — slideshow, compounds, site images (NOT units)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive — unit galleries (shared folder links)
GOOGLE_DRIVE_API_KEY=

# ——— Kwentra PMS (headless — server only; never expose to the browser) ———
# Matches the Kwentra API pack (roomtype, room-v2, room-availability, rate-v2, channelprofile,
# individualprofile-v3, individualreservation-v2). Use test.kwentra.com until going live.
KWENTRA_API_BASE_URL=https://test.kwentra.com
# Credentials — whichever Kwentra issues:
#   API token  → KWENTRA_API_TOKEN (sent as "Token <value>"; set KWENTRA_AUTH_SCHEME=Bearer if they say so)
#   API user   → KWENTRA_USERNAME + KWENTRA_PASSWORD (HTTP Basic)
KWENTRA_API_TOKEN=
# KWENTRA_AUTH_SCHEME=Token
KWENTRA_USERNAME=
KWENTRA_PASSWORD=
# Default tenant. Each property can have its own tenant ID (Admin › Properties › Kwentra tenant ID);
# properties without one use this.
KWENTRA_TENANT_ID=

# Paths default to the API pack — override only if Kwentra says so
# KWENTRA_PATH_ROOM_TYPES=/api/core/roomtype/
# KWENTRA_PATH_ROOMS=/api/reservation/room/v2/
# KWENTRA_PATH_AVAILABILITY=/api/reservation/rooms/availability/:id/
# KWENTRA_PATH_TOTAL_STAY=/api/reservation/rate/v2/totalstay/
# KWENTRA_PATH_RESERVATIONS=/api/reservation/individualreservation/v2/
# Not in the pack — set only when Kwentra provides them
# KWENTRA_PATH_DESTINATIONS=
# KWENTRA_PATH_PROJECTS=
# KWENTRA_PATH_PAYMENT=

# Inventory sync (Kwentra → website). New/edited units arrive instantly via the webhook
# POST {PUBLIC_API_URL}/api/webhooks/kwentra; the timer is a backup (0 = webhook + manual only).
PUBLIC_API_URL=
KWENTRA_WEBHOOK_SECRET=
# KWENTRA_SYNC_MINUTES=5

# Reservation defaults (integer ids from Kwentra's setup lists)
# Website channel: found automatically from the channel profile named Website/Direct/Online unless set
# KWENTRA_CHANNEL_ID=
# KWENTRA_MARKET_ID=
# KWENTRA_SOURCE_ID=
# KWENTRA_GUARANTEE_TYPE=
# Rate used for prices and bookings (otherwise the cheapest rate Kwentra offers for the room type)
# KWENTRA_DEFAULT_RATE_ID=
# Optional: website rate plan → Kwentra rate id; mapped plans use Kwentra's price for that rate as-is
# KWENTRA_RATE_MAP={"FLEX":12,"NRF":14,"WEEKLY":15}
# Hold the reservation until the guest pays, then confirm it (default: confirmed straight away)
# KWENTRA_HOLD_UNTIL_PAID=false
# KWENTRA_DEFAULT_CHILD_AGE=8
# KWENTRA_DEFAULT_CHECKIN=15:00
# KWENTRA_DEFAULT_CHECKOUT=12:00
# Let admin edits rename the room type in Kwentra (off: Kwentra keeps its own names)
# KWENTRA_PUSH_UNIT_EDITS=false

# ——— On-site payments (embedded iframe / Elements — zero guest redirects) ———
PAYMENT_PROVIDER=mock
# Paymob (Egypt) — iframe embedded in PaymentModal
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# PAYMOB_BASE_URL=https://accept.paymob.com/api
# Stripe Elements (embedded card fields)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Kwentra answers (Oct 2026): one tenant per property (set it on each property in the admin),
# website sells rates flagged web=true, market/source looked up per tenant by name.
# KWENTRA_PATH_MARKETS=/api/core/market/
# KWENTRA_PATH_SOURCES=/api/core/source/
# KWENTRA_MARKET_NAME=website|web|online|internet
# KWENTRA_SOURCE_NAME=website|web|online|internet
# Create the reservation ON_HOLD at checkout and confirm it after payment (unpaid holds auto-cancel)
KWENTRA_HOLD_UNTIL_PAID=true
KWENTRA_HOLD_DAYS=1
# Billing API: online payments are posted on the reservation's billing account (window 1) to this credit department.
# Ask each property for its 'online payment' credit department id. Per tenant: {"394":53,"375":12}
# KWENTRA_PAYMENT_DEPARTMENT_ID=
# KWENTRA_PAYMENT_DEPARTMENTS={}
# KWENTRA_PAYMENT_WINDOW=1
# KWENTRA_RESERVATION_ACCOUNT_FIELD=

# Website market/source per Kwentra tenant (JSON). Wins over KWENTRA_MARKET_ID / KWENTRA_SOURCE_ID.
# KWENTRA_MARKET_IDS={"394":"1","375":"1"}
# KWENTRA_SOURCE_IDS={"394":"5","375":"5"}
