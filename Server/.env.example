PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Admin CMS (defaults for local only)
ADMIN_EMAIL=admin@primehospitality.com
ADMIN_PASSWORD=prime-admin-dev
ADMIN_JWT_SECRET=prime-admin-dev-secret-change-me

# Database — the only database setting (Supabase › Connect › connection string).
# Tables are created automatically on startup. Unset = local JSON store (dev only).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dizqjrovjqfmrgdgntyf.supabase.co:5432/postgres

# Cloudinary — slideshow, compounds, site images (NOT units)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive — unit galleries (shared folder links)
GOOGLE_DRIVE_API_KEY=

# ——— Kwentra PMS (headless — server only; never expose to the browser) ———
# Docs: Reservation & Guest Profile APIs (Basic auth + tenant_id)
KWENTRA_API_BASE_URL=https://manage.kwentra.com
KWENTRA_TENANT_ID=
KWENTRA_USERNAME=
KWENTRA_PASSWORD=
# Or paste pre-encoded Basic token (without or with "Basic " prefix)
# KWENTRA_BASIC_TOKEN=

# Paths — confirm with Kwentra (see Server/docs/kwentra-requirements.md)
# KWENTRA_PATH_DESTINATIONS=/api/core/destination/v1
# KWENTRA_PATH_PROJECTS=/api/core/property/v1
# KWENTRA_PATH_ROOM_TYPES=/api/inventory/roomtype/v1
# KWENTRA_PATH_ROOM_TYPE=/api/inventory/roomtype/v1/:id
# KWENTRA_PATH_ROOMS=/api/inventory/room/v1
# KWENTRA_PATH_CREATE_RESERVATION=/api/reservation/individualreservation/v2
# KWENTRA_PATH_CREATE_PROFILE=/api/core/individualprofile/v3/
# KWENTRA_PATH_PAYMENT=/api/reservation/individualreservation/v2/:id/payment
# KWENTRA_ALLOW_DEFAULT_CREATE=true

# Inventory sync (Kwentra → website). New/edited units arrive instantly via the webhook
# POST {PUBLIC_API_URL}/api/webhooks/kwentra; the timer is a backup (0 = webhook + manual only).
PUBLIC_API_URL=
KWENTRA_WEBHOOK_SECRET=
# KWENTRA_SYNC_MINUTES=5

# Tenant defaults for reservation create
# KWENTRA_SOURCE_ID=
# KWENTRA_CHANNEL_ID=2
# KWENTRA_DEFAULT_RATE_ID=
# KWENTRA_DEFAULT_BOARD_TYPE_ID=
# KWENTRA_CURRENCY_ID=1
# KWENTRA_GUARANTEE_TYPE=3
# KWENTRA_DEFAULT_CHECKIN=15:00:00
# KWENTRA_DEFAULT_CHECKOUT=12:00:00

# ——— On-site payments (embedded iframe / Elements — zero guest redirects) ———
PAYMENT_PROVIDER=mock
# Paymob (Egypt) — iframe embedded in PaymentModal
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# PAYMOB_BASE_URL=https://accept.paymob.com/api
# Stripe Elements (embedded card fields)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
